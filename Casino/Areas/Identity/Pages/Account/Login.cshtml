@page
@model LoginModel
@{ ViewData["Title"] = "Login"; }
<section class="casino-login-page">
  <div class="casino-login-particles"></div>
  <div class="casino-login-card">
    <div class="casino-login-logo"><span>♠</span><h1>CASINO</h1><p>PLAYER LOGIN</p></div>
    <form method="post">
      <div asp-validation-summary="ModelOnly" class="casino-validation" role="alert"></div>
      <div class="casino-field"><label asp-for="Input.Email">EMAIL</label><input asp-for="Input.Email" autocomplete="username" placeholder="you@example.com" /><span asp-validation-for="Input.Email"></span></div>
      <div class="casino-field"><label asp-for="Input.Password">PASSWORD</label><input asp-for="Input.Password" autocomplete="current-password" placeholder="Your password" /><span asp-validation-for="Input.Password"></span></div>
      <label class="casino-remember"><input asp-for="Input.RememberMe" /> <span>Keep me signed in</span></label>
      <button class="casino-login-button" type="submit">ENTER CASINO</button>
      <div class="casino-login-links"><a asp-page="./ForgotPassword">Forgot password?</a><span>•</span><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create account</a></div>
    </form>
  </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
