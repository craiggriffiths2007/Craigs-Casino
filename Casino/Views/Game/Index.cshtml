@model Casino.Models.PlayerAccount

@{
    ViewData["Title"] = "Slot Game";
}

<div class="container text-center mt-5">

    <h1 class="mb-4">Casino Slot</h1>

    <div class="mb-3">
        Balance:
        <strong id="balance">
            @Model.Credits
        </strong>
        credits
    </div>

    <div class="mb-3">
        <label for="bet">Bet</label>

        <select id="bet"
                class="form-select d-inline-block"
                style="width:120px;">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>

    <div class="reel-window">

        <div class="reel-clip">

        <div id="reels">
            @for (int row = 0; row < 3; row++)
            {
                for (int reel = 0; reel < 5; reel++)
                {
                    <div class="slot-cell"
                         data-row="@row"
                         data-reel="@reel">
                        ?
                    </div>
                }
            }
        </div>
        </div>
        <svg id="paylineOverlay"></svg>

        <div id="phoenixOverlay"></div>

        <div id="explosionOverlay"></div>


    </div>

     


    <button id="spinButton"
            class="btn btn-primary btn-lg px-5">
        SPIN
    </button>

    <div id="winMessage"
         class="mt-3 fs-4">
    </div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script>
        const spinButton =
            document.getElementById("spinButton");

        const balance =
            document.getElementById("balance");

        const winMessage =
            document.getElementById("winMessage");

        const sleep = ms =>
            new Promise(resolve => setTimeout(resolve, ms));

        spinButton.addEventListener("click", async () => {

            spinButton.disabled = true;
            winMessage.textContent = "";

            const bet =
                document.getElementById("bet").value;

            const token =
                document.querySelector(
                    '#antiForgeryForm input[name="__RequestVerificationToken"]'
                ).value;

            const body =
                new URLSearchParams();

            body.append("bet", bet);

            body.append(
                "__RequestVerificationToken",
                token);

            try {
                const response =
                    await fetch("/Game/Spin",
                        {
                            method: "POST",
                            headers:
                            {
                                "Content-Type":
                                    "application/x-www-form-urlencoded"
                            },
                            body: body
                        });

                const data =
                    await response.json();

                if (!response.ok) {
                    winMessage.textContent =
                        data.message ?? "Spin failed.";

                    return;
                }

                // Remove any Phoenix left over from the previous spin
                clearPhoenix();

                // Show the initial board
                await animateInitialBoard(
                    data.initialBoard);

                await sleep(500);

                let runningWin = 0;

                // Play each cascade one at a time
                for (const cascade of data.cascades) {

                    runningWin += cascade.win;

                    winMessage.textContent =
                        `WIN ${cascade.win} credits`;

                    await playCascade(cascade);
                }

                balance.textContent =
                    data.balance;

                if (data.win > 0) {
                    winMessage.textContent =
                        `TOTAL WIN ${data.win} credits`;
                }
                else {
                    winMessage.textContent =
                        "No win";
                }
            }
            catch (error) {
                console.error(error);

                winMessage.textContent =
                    "Something went wrong.";
            }
            finally {
                spinButton.disabled = false;
            }
        });

        async function playCascade(cascade) {
            clearPaylines();

            // Start all winning symbols pulsing
            highlightWins(cascade.wins);

            // Show ALL winning paylines at the same time
            for (const win of cascade.wins) {
                drawPayline(win);
            }

            // Show the total for this cascade
            winMessage.textContent =
                `WIN ${cascade.win} credits`;

            // Leave all paylines visible together
            await sleep(700);

            clearPaylines();

            await sleep(150);

            await removeWinningSymbols(
                cascade.wins);

            await sleep(100);

            // Any Phoenixes that were active for this
            // cascade now expire visually
            await removePhoenixes(
                cascade.expiredPhoenixReels);

            // Existing normal symbols fall down
            await animateDrop(
                cascade.boardBefore,
                cascade.wins);

            await sleep(50);

            // Start new Phoenixes rising immediately,
            // at the same time as the replacement symbols
            if (cascade.phoenixReels &&
                cascade.phoenixReels.length > 0) {

                for (const reel of cascade.phoenixReels) {
                    showPhoenix(reel);
                }
            }

            // Normal replacement symbols fall in
            // WHILE the Phoenix is rising.
            // Phoenix reels themselves are skipped.
            await animateNewSymbols(
                cascade.boardAfter,
                cascade.wins,
                cascade.phoenixReels);

            // Give the Phoenix animation a little extra
            // time to finish if one appeared
            if (cascade.phoenixReels &&
                cascade.phoenixReels.length > 0) {

                await sleep(400);
            }

            // Synchronise the normal board with the server result
            showBoard(cascade.boardAfter);

            // Phoenix reels are represented by the large overlay,
            // so don't show the three underlying Phoenix images.
            if (cascade.phoenixReels &&
                cascade.phoenixReels.length > 0) {
                hidePhoenixCells(
                    cascade.phoenixReels);
            }

            clearPaylines();

            await sleep(500);
        }

        function hidePhoenixCells(reels) {
            for (const reel of reels) {
                for (let row = 0; row < 3; row++) {
                    getCell(row, reel).innerHTML = "";
                }
            }
        }

        async function animateInitialBoard(board) {
            const rowSpacing = 108;

            // Put symbols into their cells
            for (let row = 0; row < 3; row++) {
                for (let reel = 0; reel < 5; reel++) {
                    const cell = getCell(row, reel);

                    setSymbol(cell, board[row][reel]);

                    cell.classList.remove(
                        "winning",
                        "removed");

                    cell.style.opacity = "1";
                    cell.style.transition = "none";
                    cell.style.transform = "translateY(0)";
                }
            }

            void document.body.offsetWidth;

            // Move each reel above the screen while
            // preserving the normal spacing between rows
            for (let reel = 0; reel < 5; reel++) {
                
                const topStartOffset = -400 - Math.random() * 400;

                for (let row = 0; row < 3; row++) {
                    const cell =
                        getCell(row, reel);

                    /*
                     * Each lower row begins 108px lower
                     * than the row above it.
                     *
                     * Row 0: highest
                     * Row 1: +108px
                     * Row 2: +216px
                     */
                    const offset =
                        topStartOffset;

                    cell.style.transition = "none";

                    cell.style.transform =
                        `translateY(${offset}px)`;
                }
            }

            void document.body.offsetWidth;

            // Drop them into their real positions
            for (let row = 0; row < 3; row++) {
                for (let reel = 0; reel < 5; reel++) {
                    const cell =
                        getCell(row, reel);

                    const delay =
                        (reel * 0.17) +
                        ((2 - row) * 0.035);

                    cell.style.transition =
                        `transform 0.65s cubic-bezier(.22,.8,.3,1) ${delay}s`;

                    cell.style.transform =
                        "translateY(0)";
                }
            }

            await sleep(1300);
        }

        async function animateDrop(boardBefore, wins) {
            const removed = new Set();

            for (const win of wins) {
                for (const position of win.positions) {
                    removed.add(
                        `${position.row}-${position.reel}`);
                }
            }

            for (let reel = 0; reel < 5; reel++) {
                const survivors = [];

                // Find surviving symbols bottom to top
                for (let row = 2; row >= 0; row--) {
                    const key =
                        `${row}-${reel}`;

                    if (!removed.has(key)) {
                        survivors.push({
                            symbol:
                                boardBefore[row][reel],

                            oldRow:
                                row
                        });
                    }
                }

                // Clear this reel visually
                for (let row = 0; row < 3; row++) {
                    const cell =
                        getCell(row, reel);

                    cell.innerHTML = "";

                    cell.classList.remove(
                        "winning",
                        "removed");

                    cell.style.opacity = "1";
                    cell.style.transform = "translateY(0)";
                }

                let targetRow = 2;
                let survivorIndex = 0;

                for (const survivor of survivors) {
                    const cell =
                        getCell(targetRow, reel);

                    setSymbol(
                        cell,
                        survivor.symbol);

                    const distance =
                        targetRow - survivor.oldRow;

                    cell.style.transition = "none";

                    cell.style.transform =
                        `translateY(${-distance * 108}px)`;

                    cell.style.opacity = "1";

                    void cell.offsetWidth;

                    const delay =
                        survivorIndex * 0.06;

                    cell.style.transition =
                        `transform 0.45s ease ${delay}s`;

                    cell.style.transform =
                        "translateY(0)";

                    targetRow--;
                    survivorIndex++;
                }
            }

            await sleep(550);
        }

        async function animateNewSymbols(
            boardAfter,
            wins,
            phoenixReels)
        {
            const removed = new Set();

            const phoenixSet = new Set(phoenixReels ?? []);

            for (const win of wins)
            {
                for (const position of win.positions)
                {
                    removed.add(
                        `${position.row}-${position.reel}`);
                }
            }

            for (let reel = 0; reel < 5; reel++)
            {
                // This reel is becoming a Phoenix,
                // so do NOT animate normal replacement symbols into it.
                if (phoenixSet.has(reel))
                    continue;
                // Count how many symbols were removed from this reel
                let removedCount = 0;

                for (let row = 0; row < 3; row++)
                {
                    if (removed.has(`${row}-${reel}`))
                    {
                        removedCount++;
                    }
                }

                if (removedCount === 0)
                    continue;

                // New symbols will occupy the top rows
                for (let row = 0; row < removedCount; row++)
                {
                    const cell = getCell(row, reel);

                    setSymbol(
                        cell,
                        boardAfter[row][reel]);

                    cell.classList.remove(
                        "winning",
                        "removed");

                    cell.style.opacity = "1";
                    cell.style.transition = "none";

                    // Start above the grid
                    const startDistance =
                        ((removedCount - row) * 108) +
                        250 +
                        (Math.random() * 200);

                    cell.style.transform =
                        `translateY(${-startDistance}px)`;

                    // Force browser to render starting position
                    void cell.offsetWidth;

                    // Random delay for the whole reel
                    const reelDelay =
                        Math.random() * 0.12;

                    // Symbols are released bottom-to-top
                    let rowDelay = 0;

                    if (row === removedCount - 1) {

                        // Bottom symbol
                        rowDelay =
                            Math.random() * 0.05;
                    }
                    else if (row === removedCount - 2) {

                        // Middle symbol
                        rowDelay =
                            0.08 +
                            Math.random() * 0.10;
                    }
                    else {

                        // Top symbol
                        rowDelay =
                            0.18 +
                            Math.random() * 0.14;
                    }

                    const delay =
                        reelDelay + rowDelay;

                    cell.style.transition =
                        `transform 0.65s cubic-bezier(.22,.8,.3,1) ${delay}s`;

                    cell.style.transform =
                        "translateY(0)";
                }
            }

            await sleep(850);
        }

        function showBoard(board) {
            for (let row = 0; row < 3; row++) {
                for (let reel = 0; reel < 5; reel++) {
                    const cell =
                        getCell(row, reel);

                    cell.style.transition = "none";
                    cell.style.transform = "translateY(0)";
                    cell.style.opacity = "1";

                    setSymbol(
                        cell,
                        board[row][reel]);

                    cell.classList.remove(
                        "winning",
                        "removed");

                    void cell.offsetWidth;

                    cell.style.transition = "";
                }
            }
        }

        function highlightWins(wins) {
            for (const win of wins) {
                for (const position of win.positions) {
                    const cell =
                        getCell(
                            position.row,
                            position.reel);

                    cell.classList.add("winning");
                }
            }
        }

        async function removeWinningSymbols(wins) {
            const processed = new Set();

            const winningCells = [];

            for (const win of wins) {
                for (const position of win.positions) {

                    const key =
                        `${position.row}-${position.reel}`;

                    if (processed.has(key))
                        continue;

                    processed.add(key);

                    const cell =
                        getCell(
                            position.row,
                            position.reel);

                    winningCells.push(cell);

                    cell.classList.remove("winning");

                    // Add fireball
                    showFireball(cell);

                    // Animate symbol itself
                    const img =
                        cell.querySelector(".slot-symbol");

                    if (img) {
                        img.classList.add("symbol-explode");
                    }
                }
            }

            // Allow explosion animation to play
            await sleep(350);

            // NOW remove all winning symbols
            for (const cell of winningCells) {
                cell.innerHTML = "";
                cell.classList.add("removed");
            }
        }

        function clearHighlights() {
            document
                .querySelectorAll(".slot-cell.winning")
                .forEach(cell => {
                    cell.classList.remove("winning");
                });
        }

        function getCell(row, reel) {
            return document.querySelector(
                `[data-row="${row}"][data-reel="${reel}"]`
            );

            


        }

        function setSymbol(cell, symbol) {
            if (!symbol) {
                cell.innerHTML = "";
                return;
            }

            // Phoenix is drawn using the large overlay,
            // never as a normal 90x90 reel symbol
            if (symbol.toLowerCase() === "phoenix") {
                cell.innerHTML = "";
                return;
            }

            const fileName =
                symbol.toLowerCase();

            cell.innerHTML =
                `<img src="/images/symbols/${fileName}.png"
                      class="slot-symbol"
                      alt="${symbol}">`;
        }

        function clearPaylines() {
            const svg =
                document.getElementById("paylineOverlay");

            if (svg)
                svg.innerHTML = "";
        }

        function drawPayline(win) {
            const svg =
                document.getElementById("paylineOverlay");

            const reelWindow =
                document.querySelector(".reel-window");

            const windowRect =
                reelWindow.getBoundingClientRect();

            const points = [];

            for (const position of win.positions) {
                const cell =
                    getCell(
                        position.row,
                        position.reel);

                const rect =
                    cell.getBoundingClientRect();

                const x =
                    rect.left -
                    windowRect.left +
                    (rect.width / 2);

                const y =
                    rect.top -
                    windowRect.top +
                    (rect.height / 2);

                points.push(`${x},${y}`);
            }

            const polyline =
                document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "polyline");

            polyline.setAttribute(
                "points",
                points.join(" "));

            polyline.setAttribute(
                "fill",
                "none");

            polyline.setAttribute(
                "stroke",
                "#ff2020");

            polyline.setAttribute(
                "stroke-width",
                "6");

            polyline.setAttribute(
                "stroke-linecap",
                "round");

            polyline.setAttribute(
                "stroke-linejoin",
                "round");

            svg.appendChild(polyline);
        }

        async function showPhoenix(reel) {
            const overlay =
                document.getElementById("phoenixOverlay");

            // Remove an existing Phoenix on THIS reel only
            const existing =
                overlay.querySelector(
                    `[data-phoenix-reel="${reel}"]`);

            if (existing)
                existing.remove();

            // Hide the 3 normal cells on this reel
            for (let row = 0; row < 3; row++) {
                const cell =
                    getCell(row, reel);

                cell.innerHTML = "";
            }

            const img =
                document.createElement("img");

            img.src =
                "/images/symbols/phoenix.png";

            img.className =
                "phoenix-symbol";

            img.dataset.phoenixReel =
                reel;

            img.style.left =
                `${reel * 108}px`;

            img.style.top =
                "0px";

            overlay.appendChild(img);

            void img.offsetWidth;

            img.classList.add("appear");

            //await sleep(950);
        }

        function clearPhoenix() {
            const overlay =
                document.getElementById("phoenixOverlay");

            overlay.innerHTML = "";
        }

        async function removePhoenix(reel) {
            const overlay =
                document.getElementById("phoenixOverlay");

            const phoenix =
                overlay.querySelector(
                    `[data-phoenix-reel="${reel}"]`);

            if (!phoenix)
                return;

            // Add explosion over the Phoenix
            const explosion =
                document.createElement("div");

            explosion.className =
                "phoenix-explosion";

            explosion.style.left =
                `${reel * 108 + 50}px`;

            explosion.style.top =
                "158px";

            overlay.appendChild(explosion);

            // Animate Phoenix itself
            phoenix.classList.add(
                "phoenix-explode");

            await sleep(500);

            phoenix.remove();
            explosion.remove();
        }

        async function removePhoenixes(reels) {
            if (!reels)
                return;

            await Promise.all(
                reels.map(reel =>
                    removePhoenix(reel)));
        }


        function showFireball(cell) {
            const overlay =
                document.getElementById("explosionOverlay");

            const reelWindow =
                document.querySelector(".reel-window");

            const cellRect =
                cell.getBoundingClientRect();

            const windowRect =
                reelWindow.getBoundingClientRect();

            const fireball =
                document.createElement("div");

            fireball.className =
                "fireball";

            fireball.style.left =
                `${cellRect.left
                - windowRect.left
                + cellRect.width / 2}px`;

            fireball.style.top =
                `${cellRect.top
                - windowRect.top
                + cellRect.height / 2}px`;

            overlay.appendChild(fireball);

            setTimeout(() => {
                fireball.remove();
            }, 500);
        }

    </script>


    <style>
        .slot-cell {
            width: 100px;
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            font-size: 18px;
            font-weight: bold;
            transition: transform 0.4s ease, opacity 0.25s ease, background-color 0.25s ease;
        }

            .slot-cell.winning {
                animation: symbolFlash 0.25s ease-in-out infinite alternate;
            }

        .slot-cell.removed {
            opacity: 0;
            transform: scale(0.3);
        }

        .reel-window {
            position: relative;
            width: 540px;
            height: 316px;
            margin: 30px auto 24px auto;
            overflow: hidden;
        }

        #paylineOverlay {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 40;
        }

        #reels {
            display: grid;
            grid-template-columns: repeat(5, 100px);
            grid-template-rows: repeat(3, 100px);
            gap: 8px;
            justify-content: center;
        }


        .slot-symbol {
            width: 90px;
            height: 90px;
            object-fit: contain;
            display: block;
            pointer-events: none;
            user-select: none;
        }

        @@keyframes symbolFlash {
            from {
                transform: scale(1);
                filter: brightness(1) drop-shadow(0 0 0 transparent);
            }

            to {
                transform: scale(1.15);
                filter: brightness(1.5) drop-shadow(0 0 10px #ffd700) drop-shadow(0 0 18px #ffffff);
            }
        }

        #phoenixOverlay {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 30;
        }

        .phoenix-symbol {
            position: absolute;
            width: 140px;
            height: 100%;
            object-fit: contain;
            opacity: 0;
            transform: translateX(-20px) translateY(170px) scale(0.35);
            transform-origin: bottom center;
            filter: brightness(1.5) drop-shadow(0 0 15px orange) drop-shadow(0 0 30px red);
            z-index: 30;
        }

            .phoenix-symbol.appear {
                animation: phoenixRise 0.9s ease-out forwards;
            }

        @@keyframes phoenixRise {
            0% {
                opacity: 0;
                transform: translateX(-20px) translateY(170px) scale(0.35);
            }

            60% {
                opacity: 1;
                transform: translateX(-20px) translateY(-5px) scale(1.08);
            }

            100% {
                opacity: 1;
                transform: translateX(-20px) translateY(0) scale(1);
            }
        }



        .fireball {
            position: absolute;
            width: 35px;
            height: 35px;
            transform: translate(-50%, -50%) scale(0.2);
            border-radius: 50%;
            background: radial-gradient( circle, white 0%, #fff200 15%, #ff9d00 35%, #ff3300 60%, rgba(255, 0, 0, 0) 75% );
            box-shadow: 0 0 12px #ffff00, 0 0 25px #ff9900, 0 0 40px #ff3300;
            pointer-events: none;
            animation: fireballExplosion 0.5s ease-out forwards;
        }

        @@keyframes fireballExplosion {
            0% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(0.2);
            }

            45% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(2.2);
            }

            100% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(3);
            }
        }

        .symbol-explode {
            animation: symbolExplode 0.35s ease-in forwards;
        }

        @@keyframes symbolExplode {
            0% {
                opacity: 1;
                transform: scale(1);
                filter: brightness(1);
            }

            40% {
                opacity: 1;
                transform: scale(1.25);
                filter: brightness(3);
            }

            100% {
                opacity: 0;
                transform: scale(0.2);
                filter: brightness(5);
            }
        }

        .phoenix-explosion {
            position: absolute;
            width: 70px;
            height: 70px;
            transform: translate(-50%, -50%) scale(0.2);
            border-radius: 50%;
            background: radial-gradient( circle, white 0%, #fff200 12%, #ff9d00 30%, #ff3300 55%, rgba(255, 0, 0, 0) 75% );
            box-shadow: 0 0 20px #ffff00, 0 0 40px #ff9900, 0 0 70px #ff3300;
            pointer-events: none;
            z-index: 60;
            animation: phoenixExplosion 0.5s ease-out forwards;
        }

        .phoenix-explode {
            animation: phoenixExplode 0.5s ease-in forwards !important;
        }

        @@keyframes phoenixExplosion {
            0% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(0.2);
            }

            45% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1.8);
            }

            100% {
                opacity: 0;
                transform: translate(-50%, -50%) scale(0.3);
            }
        }

        @@keyframes phoenixExplode {
            0% {
                opacity: 1;
                transform: translateX(-20px) translateY(0) scale(1);
                filter: brightness(1.5) drop-shadow(0 0 15px orange) drop-shadow(0 0 30px red);
            }

            35% {
                opacity: 1;
                transform: translateX(-20px) translateY(0) scale(1.18);
                filter: brightness(4) drop-shadow(0 0 30px yellow) drop-shadow(0 0 55px orange);
            }

            100% {
                opacity: 0;
                transform: translateX(-20px) translateY(0) scale(0.1);
                filter: brightness(6) blur(3px);
            }
        }






        html,
        body {
            min-height: 100%;
        }

        body {
            background: linear-gradient( rgba(4, 8, 18, 0.20), rgba(4, 8, 18, 0.45) ), url('/images/phoenix-bg.png') center center / cover fixed no-repeat;
            color: #fff;
        }

        .container {
            position: relative;
            z-index: 1;
        }

        h1 {
            color: #ffd45a;
            text-shadow: 0 2px 3px #000, 0 0 12px rgba(255, 150, 20, 0.55);
        }

        #balance,
        #winMessage {
            color: #fff;
            text-shadow: 0 2px 4px #000, 0 0 8px rgba(0, 0, 0, 0.8);
        }

        #bet {
            background-color: rgba(15, 20, 30, 0.88);
            color: #fff;
            border: 1px solid #c99a35;
        }

        #spinButton {
            border: 1px solid #ffbe32;
            box-shadow: 0 0 12px rgba(255, 145, 0, 0.55), inset 0 0 8px rgba(255, 220, 100, 0.25);
        }

        .reel-window {
            position: relative;
            width: 540px;
            height: 316px;
            margin: 30px auto 24px auto;
            overflow: visible;
