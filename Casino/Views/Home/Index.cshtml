@{
    ViewData["Title"] = "Welcome";

    var isSignedIn = User.Identity?.IsAuthenticated == true;

    var phoenixUrl = Url.Action("Index", "Game") ?? "/Game";
    var reelCatchUrl = Url.Action("ReelCatch", "Game") ?? "/Game/ReelCatch";

    var phoenixPlayUrl = isSignedIn
        ? phoenixUrl
        : Url.Page("/Account/Login", new { area = "Identity", returnUrl = phoenixUrl });

    var reelCatchPlayUrl = isSignedIn
        ? reelCatchUrl
        : Url.Page("/Account/Login", new { area = "Identity", returnUrl = reelCatchUrl });

    var credits = (long)(ViewBag.Credits ?? 10000L);
}

<div class="casino-public-home">
    <section class="casino-welcome casino-home-hero">
        <div class="casino-welcome-glow"></div>
        <div class="casino-welcome-content">
            <div class="casino-suit-row">♠ &nbsp; ♦ &nbsp; ♣ &nbsp; ♥</div>
            <p class="casino-eyebrow">WELCOME TO</p>
            <h1>CRAIGS CASINO</h1>
            <p class="casino-welcome-copy">Pick a game, take your seat and play with credits.</p>

            <div class="casino-welcome-actions">
                <a class="casino-enter-button" href="#games">VIEW GAMES</a>

                @if (!isSignedIn)
                {
                    <a class="casino-register-link"
                       asp-area="Identity"
                       asp-page="/Account/Register"
                       asp-route-returnUrl="@Url.Action("Index", "Home")">
                        Create an account
                    </a>
                }
            </div>
        </div>
    </section>

    <section id="games" class="casino-public-games">
        <div class="lobby-ambient lobby-ambient-one"></div>
        <div class="lobby-ambient lobby-ambient-two"></div>

        <div class="lobby-header">
            <div>
                <p class="casino-eyebrow">CASINO FLOOR</p>
                <h2>CHOOSE YOUR GAME</h2>
                <p>
                    @if (isSignedIn)
                    {
                        <text>Pick a machine and play.</text>
                    }
                    else
                    {
                        <text>Browse the games. You’ll be asked to log in when you press PLAY.</text>
                    }
                </p>
            </div>

            @if (isSignedIn)
            {
                <div class="lobby-wallet">
                    <span>BALANCE</span>
                    <strong>@credits.ToString("N0")</strong>
                    <small>CREDITS</small>
                </div>
            }
        </div>

        <div class="casino-game-grid">
            <a href="@phoenixPlayUrl" class="casino-game-card phoenix-game">
                <div class="game-art phoenix-art">
                    <img src="/images/phoenix-bg.png" alt="Phoenix Slots" />
                    <div class="game-art-shade"></div>
                    <div class="game-badge">CASCADE SLOTS</div>
                </div>
                <div class="game-card-info">
                    <div>
                        <h2>PHOENIX</h2>
                        <p>5 × 3 cascading wins</p>
                    </div>
                    <span class="game-play">PLAY</span>
                </div>
            </a>

            <a href="@reelCatchPlayUrl" class="casino-game-card reelcatch-game">
                <div class="game-art reelcatch-art">
                    <div class="reelcatch-water"></div>
                    <span class="lobby-hook">🎣</span>
                    <span class="lobby-fish">🐟</span>
                    <div class="game-badge">10 PAYLINES</div>
                </div>
                <div class="game-card-info">
                    <div>
                        <h2>REEL CATCH</h2>
                        <p>Cash fish • free spins • collector</p>
                    </div>
                    <span class="game-play">PLAY</span>
                </div>
            </a>

            <div class="casino-game-card coming-soon" aria-disabled="true">
                <div class="game-art coming-art">
                    <span>♛</span>
                    <div class="game-badge">COMING SOON</div>
                </div>
                <div class="game-card-info">
                    <div>
                        <h2>NEW GAME</h2>
                        <p>Another machine is on the way</p>
                    </div>
                </div>
            </div>
        </div>

        <p class="lobby-tip">
            @(isSignedIn ? "SELECT A GAME TO BEGIN" : "PLAY REQUIRES A PLAYER ACCOUNT")
        </p>
    </section>
</div>
