<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Casino</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Casino.styles.css" asp-append-version="true" />
</head>
<body class="casino-body">
    <header class="casino-topbar">
        <a class="casino-brand" asp-controller="Home" asp-action="Lobby">
            <span class="casino-brand-mark">♠</span><span>CRAIGS CASINO</span>
        </a>
        <partial name="_LoginPartial" />
    </header>
    <main role="main" class="casino-main">@RenderBody()</main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
