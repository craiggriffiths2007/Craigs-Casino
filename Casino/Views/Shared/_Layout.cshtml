<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Casino</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Casino.styles.css" asp-append-version="true" />

    <meta property="og:title" content="Craigs Casino - Demo Project" />
    <meta property="og:description"
          content="A C# and ASP.NET Core hobby project exploring slot game mechanics using virtual credits only. No real money." />

    <meta property="og:image"
          content="https://craigscasino.runasp.net/images/craigscasino-social.png" />

    <meta property="og:image:secure_url"
          content="https://craigscasino.runasp.net/images/craigscasino-social.png" />

    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta property="og:url" content="https://craigscasino.runasp.net/" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Craigs Casino - Demo Project" />
    <meta name="twitter:description"
          content="A C# and ASP.NET Core hobby project exploring slot game mechanics using virtual credits only. No real money." />
    <meta name="twitter:image"
          content="https://craigscasino.runasp.net/images/craigscasino-social.png" />

    <link rel="icon"
          type="image/png"
          href="~/images/favicon.png" />

    <link rel="manifest"
          href="~/manifest.json" />
</head>
<body class="casino-body">
    <header class="casino-topbar">
        <a class="casino-brand" asp-controller="Home" asp-action="Index">
            <span class="casino-brand-mark">♠</span><span>CRAIGS CASINO</span>
        </a>
        <partial name="_LoginPartial" />
    </header>
    <main role="main" class="casino-main">@RenderBody()</main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
